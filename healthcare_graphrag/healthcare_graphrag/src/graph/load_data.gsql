// load_data.gsql
// Loads symptom_disease_graph.csv into HealthcareGraph.
// CSV columns: symptom, disease

USE GRAPH HealthcareGraph

BEGIN
CREATE LOADING JOB load_healthcare_data FOR GRAPH HealthcareGraph {

    // ── File definition ─────────────────────────────────────────
    DEFINE FILENAME f = "/path/to/data/processed/symptom_disease_graph.csv";

    // ── Load Disease vertices ────────────────────────────────────
    LOAD f TO VERTEX Disease VALUES (
        $"disease",   // PRIMARY_ID  = disease name (used as ID)
        $"disease"    // name attribute
    ) USING SEPARATOR=",", HEADER="true", EOL="\n";

    // ── Load Symptom vertices ────────────────────────────────────
    LOAD f TO VERTEX Symptom VALUES (
        $"symptom",   // PRIMARY_ID  = symptom name (used as ID)
        $"symptom"    // name attribute
    ) USING SEPARATOR=",", HEADER="true", EOL="\n";

    // ── Load has_symptom edges ───────────────────────────────────
    LOAD f TO EDGE has_symptom VALUES (
        $"disease",   // FROM Disease
        $"symptom"    // TO   Symptom
    ) USING SEPARATOR=",", HEADER="true", EOL="\n";
}
END

// Run the loading job
RUN LOADING JOB load_healthcare_data
